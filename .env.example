# BuildMart AI — Environment Variables
# Copy this file to .env and fill in your values

# MySQL
MYSQL_ROOT_PASSWORD=buildmart123
MYSQL_PASSWORD=buildmart123

# Redis (leave empty for no password)
REDIS_PASSWORD=

# JWT Secret (must be 64+ chars)
JWT_SECRET=BuildMartSecretKey2024SuperLongSecretKeyForJWTTokenGenerationMinimum512Bits

# OpenAI — Required for AI features
# Get key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Gmail SMTP (for email verification)
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password

# AWS S3 (optional)
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_S3_BUCKET=buildmart-uploads

CORS_ORIGINS=http://localhost:3000
REACT_APP_API_URL=/api
REACT_APP_ENV=production
